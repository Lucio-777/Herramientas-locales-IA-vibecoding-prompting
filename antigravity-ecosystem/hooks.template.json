{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"__USER_HOME_POSIX__/.gemini/config/hooks/safety_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "auto-format-lint": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"__USER_HOME_POSIX__/.gemini/config/hooks/post_edit_lint.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

